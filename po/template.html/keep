<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>MGC — P-1 CASE FILE</title>
<style>
  body, .mgc-main-viewport {
    background-color: #0D0200 !important;
    background-image: 
      
      linear-gradient(105deg, rgba(255,255,255,0.07) 0%, rgba(255,255,255,0) 12%, rgba(255,255,255,0.07) 13%, rgba(255,255,255,0) 30%),
      linear-gradient(45deg, rgba(255,255,255,0.05) 0%, rgba(255,255,255,0) 20%, rgba(255,255,255,0.05) 21%, rgba(255,255,255,0) 50%),
      linear-gradient(165deg, rgba(255,255,255,0) 40%, rgba(255,255,255,0.06) 42%, rgba(255,255,255,0) 45%),
      linear-gradient(25deg, rgba(255,255,255,0) 60%, rgba(255,255,255,0.05) 62%, rgba(255,255,255,0) 68%),
      linear-gradient(115deg, rgba(255,255,255,0) 75%, rgba(255,255,255,0.08) 77%, rgba(255,255,255,0) 80%),
      
      radial-gradient(circle at 50% 50%, #260000 0%, #0D0200 70%, #000000 100%) !important;
    background-attachment: fixed !important;
    background-size: cover !important;
    min-height: 100vh !important;
    color: #BF4500 !important;
  }

  p, span, h1, h2, h3, li {
    color: #BF4500 !important;
    font-weight: 900 !important;
  }

  @keyframes magmaTremble {
    0% { transform: translate(0,0) scale(1); }
    20% { transform: translate(-1px,1px) scale(1.002); }
    40% { transform: translate(-1px,-1px) scale(0.998); }
    60% { transform: translate(1px,1px) scale(1.001); }
    80% { transform: translate(1px,-1px) scale(0.999); }
    100% { transform: translate(0,0) scale(1); }
  }

  @keyframes magmaFlow {
    0% { color: #BF4500; border-color: #3D0000; box-shadow: 0 4px 15px rgba(191,69,0,0.2); }
    50% { color: #FF5C00; border-color: #630000; box-shadow: 0 4px 25px rgba(255,92,0,0.4); }
    100% { color: #BF4500; border-color: #3D0000; box-shadow: 0 4px 15px rgba(191,69,0,0.2); }
  }

  .p1-dungeon-link {
    display: inline-block !important;
    width: 85vw !important;
    max-width: 600px !important;
    margin: 14px auto !important;
    padding: 16px 0px !important;
    background: #000000 !important;
    border: 6px solid #3D0000 !important;
    border-radius: 2px !important;
    font-weight: 900 !important;
    font-size: 14.4px !important;
    letter-spacing: 0.75px !important;
    text-decoration: none !important;
    text-align: center !important;
    box-sizing: border-box !important;
    animation: magmaFlow 3s infinite ease-in-out, magmaTremble 0.25s infinite !important;
  }
  body::after {
    content: "";
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(0deg, rgba(0,0,0,0.25) 0px, rgba(0,0,0,0.25) 1px, transparent 1px, transparent 3px);
    pointer-events: none;
    z-index: 99;
  }
  canvas {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 50;
  }
</style>
  <script>
  const canvas = document.getElementById('goreCanvas');
  const ctx = canvas.getContext('2d');
  let w, h;
  let drops = [];

  function resize() {
    w = canvas.width = window.innerWidth;
    h = canvas.height = window.innerHeight;
  }
  window.addEventListener('resize', resize);
  resize();

  class BloodDrop {
    constructor(x, y, isSplatter) {
      this.x = x;
      this.y = y;
      this.r = isSplatter ? Math.random() * 4 + 1.5 : Math.random() * 3 + 2;
      this.vx = isSplatter ? (Math.random() - 0.5) * 14 : 0;
      this.vy = isSplatter ? (Math.random() - 0.8) * 12 : Math.random() * 1.4 + 0.4;
      this.gravity = isSplatter ? 0.45 : 0.015;
      this.drag = isSplatter ? 0.94 : 1;
      this.color = Math.random() > 0.3 ? '#8a0303' : '#cc0000';
      this.trail = [];
      this.isSplatter = isSplatter;
      this.life = 100;
    }

    update() {
      if (this.isSplatter) {
        this.vx *= this.drag;
        this.vy += this.gravity;
        this.x += this.vx;
        this.y += this.vy;
        this.life -= 2;

        if (this.life < 60 && Math.random() > 0.85) {
          this.isSplatter = false;
          this.vx = 0;
          this.vy = Math.random() * 0.8 + 0.2;
        }
      } else {
        this.trail.push({ x: this.x, y: this.y, r: this.r });
        if (this.trail.length > 28) this.trail.shift();
        this.y += this.vy;
        this.r *= 0.996;
      }
    }

    draw() {
      ctx.fillStyle = this.color;
      if (!this.isSplatter) {
        for (let i = 0; i < this.trail.length; i++) {
          const t = this.trail[i];
          const alpha = (i / this.trail.length) * 0.7;
          ctx.globalAlpha = alpha;
          ctx.beginPath();
          ctx.arc(t.x, t.y, t.r * 0.75, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 0.9;
      ctx.beginPath();
      ctx.arc(this.x, this.y, this.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.globalAlpha = 1;
    }
  }

  function spawnSplatter(x, y, count = 28) {
    for (let i = 0; i < count; i++) {
      drops.push(new BloodDrop(x, y, true));
    }
  }

  
  for (let i = 0; i < 14; i++) {
    drops.push(new BloodDrop(Math.random() * w, Math.random() * 30, false));
  }

  document.getElementById('triggerBtn').addEventListener('click', (e) => {
    const rect = e.target.getBoundingClientRect();
    spawnSplatter(rect.left + rect.width / 2, rect.top + rect.height / 2, 36);
  });

  document.querySelectorAll('.bleed-btn').forEach(btn => {
    btn.addEventListener('mouseenter', (e) => {
      const rect = e.target.getBoundingClientRect();
      spawnSplatter(rect.left + Math.random() * rect.width, rect.top, 8);
    });
  });

  function animate() {
    ctx.clearRect(0, 0, w, h);

    if (Math.random() < 0.04 && drops.length < 120) {
      drops.push(new BloodDrop(Math.random() * w, -5, false));
    }

    for (let i = drops.length - 1; i >= 0; i--) {
      drops[i].update();
      drops[i].draw();
      if (drops[i].y > h + 40 || drops[i].r < 0.25 || drops[i].life <= 0) {
        drops.splice(i, 1);
      }
    }

    requestAnimationFrame(animate);
  }

  animate();
</script>
</div>
</body>
</html>
